{
    "name": "devlaunch",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "initializeCommand": ".devcontainer/claude-code/init-host.sh",
    "customizations": {
        "vscode": {
            "settings": {},
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "jjjermiah.pixi-vscode",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "mhutchie.git-graph"
              ]
        }
    },
	"features": {
		"./claude-code": {},

        // A Docker daemon of our own, so devpod can create real containers from
        // in here and the e2e suite (pytest -m e2e) has something to run against.
        // The feature brings its own "privileged": true, init process, entrypoint
        // and /var/lib/docker volume, so nothing else has to be arranged for it.
        //
        // Note this is why there is no "--network=host" in runArgs: that shares
        // the host's network namespace, where the host's own docker0 bridge is
        // already up. A second daemon in that namespace would co-manage that
        // bridge and write its NAT rules into the host's netfilter tables,
        // fighting the host's Docker rather than nesting under it. The e2e
        // harness in test/docker/docker-compose.test.yml runs dind on a private
        // network for the same reason.
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}

		// "ghcr.io/devcontainers/features/common-utils:2": {},
		// "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		// "ghcr.io/jsburckhardt/devcontainer-features/codex:latest": {}
    },
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "XDG_CONFIG_HOME": "/home/vscode/.config",
        "XDG_CACHE_HOME": "/home/vscode/.cache",
        "XDG_DATA_HOME": "/home/vscode/.local/share",
        "SSH_AUTH_SOCK": "/home/vscode/.ssh/agent.sock"
    },
    "mounts": [
        "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume",
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind",
        "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind"
    ],
    "postCreateCommand": "sudo chown vscode .pixi && pixi install"
}
